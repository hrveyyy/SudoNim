# CareLink environment variables.
# Copy to .env.local and fill in real values. Never commit real values.

# --- Client (safe to expose to the browser via Vite's VITE_ prefix) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173

# --- Edge Functions only (NEVER expose to the browser or commit) ---
# These are documented here for completeness but must only ever be set in the
# Supabase Edge Function environment, not in the client build.
# SUPABASE_SERVICE_ROLE_KEY=
# QR_HMAC_SECRET=
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_NAME=
